---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Reveal from '../islands/Reveal.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skills = [
  'C#', '.NET Core', 'ASP.NET', 'Web API', 'Blazor',
  'SQL Server', 'MongoDB', 'Docker', 'Azure', 'Logic Apps',
];

const bio = {
  en: 'I am a software engineer focused on .NET and Azure backend systems. I build APIs, services, and cloud integrations, and I have led the migration of complex BizTalk orchestrations to Azure Logic Apps.',
  sr: 'Software inženjer fokusiran na .NET i Azure backend sisteme. Gradim API-je, servise i cloud integracije, i vodio sam migraciju kompleksnih BizTalk orkestracija na Azure Logic Apps.',
};

const experience = [
  {
    role: 'Azure Integration Engineer',
    company: 'CHC Helicopter',
    period: { en: 'Dec 2025 – Present', sr: 'Dec 2025 – danas' },
    note: { en: 'Migrating BizTalk orchestrations to Azure Logic Apps (Remote).', sr: 'Migracija BizTalk orkestracija na Azure Logic Apps (Remote).' },
  },
  {
    role: 'Software Engineer',
    company: 'Binary Consulting Belgrade',
    period: { en: 'May 2024 – Present', sr: 'Maj 2024 – danas' },
    note: { en: 'C#, ASP.NET, Web API and backend services.', sr: 'C#, ASP.NET, Web API i backend servisi.' },
  },
];
---
<section id="about" class="mx-auto max-w-5xl px-6 py-24 scroll-mt-20">
  <Reveal client:visible>
    <h2 class="text-3xl sm:text-4xl font-bold">{t('about.title')}</h2>
    <p class="text-muted mt-6 max-w-2xl leading-relaxed">{bio[lang]}</p>

    <h3 class="text-xl font-semibold mt-12">{t('about.skills')}</h3>
    <ul class="flex flex-wrap gap-2 mt-4">
      {skills.map((s) => (
        <li class="px-3 py-1 rounded-full bg-surface border border-white/10 text-sm text-muted">{s}</li>
      ))}
    </ul>

    <h3 class="text-xl font-semibold mt-12">{t('about.experience')}</h3>
    <ul class="mt-4 space-y-6">
      {experience.map((e) => (
        <li class="border-l-2 border-accent/40 pl-4">
          <p class="font-medium">{e.role} · <span class="text-accent-2">{e.company}</span></p>
          <p class="text-sm text-muted">{e.period[lang]}</p>
          <p class="text-sm text-muted mt-1">{e.note[lang]}</p>
        </li>
      ))}
    </ul>
  </Reveal>
</section>
