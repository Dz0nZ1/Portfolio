---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Reveal from '../islands/Reveal.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skills = [
  'C#', '.NET Core', 'ASP.NET', 'Web API', 'Blazor',
  'SQL Server', 'MongoDB', 'Docker', 'Azure', 'Logic Apps',
];

const bio = {
  en: 'I am a software engineer focused on .NET and Azure backend systems. I build APIs, services, and cloud integrations, and I have led the migration of complex BizTalk orchestrations to Azure Logic Apps.',
  sr: 'Software inženjer fokusiran na .NET i Azure backend sisteme. Gradim API-je, servise i cloud integracije, i vodio sam migraciju kompleksnih BizTalk orkestracija na Azure Logic Apps.',
};

const experience = [
  {
    role: 'Azure Integration Engineer',
    company: 'CHC Helicopter',
    period: { en: 'Dec 2025 – Present', sr: 'Dec 2025 – danas' },
    note: { en: 'Migrating BizTalk orchestrations to Azure Logic Apps (Remote).', sr: 'Migracija BizTalk orkestracija na Azure Logic Apps (Remote).' },
  },
  {
    role: 'Software Engineer',
    company: 'Binary Consulting Belgrade',
    period: { en: 'May 2024 – Present', sr: 'Maj 2024 – danas' },
    note: { en: 'C#, ASP.NET, Web API and backend services.', sr: 'C#, ASP.NET, Web API i backend servisi.' },
  },
];
---
<section id="about" class="mx-auto max-w-6xl px-6 py-28 scroll-mt-20">
  <Reveal client:visible>
    <div class="flex items-center gap-4 mb-10">
      <span class="section-tag">01 / {t('nav.about')}</span>
      <div class="h-0.5 flex-1 bg-line/30"></div>
    </div>

    <h2 class="text-4xl sm:text-6xl font-bold uppercase max-w-3xl">{t('about.title')}</h2>
    <p class="text-muted mt-8 max-w-2xl leading-relaxed font-mono text-sm sm:text-base">{bio[lang]}</p>

    <div class="grid lg:grid-cols-2 gap-12 mt-16">
      <!-- Stack -->
      <div>
        <h3 class="kicker text-accent-2 mb-5">{t('about.skills')}</h3>
        <ul class="flex flex-wrap gap-2.5">
          {skills.map((s) => (
            <li class="chip">{s}</li>
          ))}
        </ul>
      </div>

      <!-- Experience -->
      <div>
        <h3 class="kicker text-accent-2 mb-5">{t('about.experience')}</h3>
        <ul class="space-y-4">
          {experience.map((e, i) => (
            <li class="brutal-card p-5">
              <div class="flex items-baseline justify-between gap-3 flex-wrap">
                <p class="font-display font-bold text-lg">{e.role}</p>
                <span class="font-mono text-xs text-accent">0{i + 1}</span>
              </div>
              <p class="font-mono text-sm text-accent-3 mt-1">{e.company}</p>
              <p class="font-mono text-xs text-muted mt-2">{e.period[lang]}</p>
              <p class="text-sm text-muted mt-2 leading-relaxed">{e.note[lang]}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Reveal>
</section>
