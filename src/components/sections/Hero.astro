---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import HeroAnimation from '../islands/HeroAnimation.tsx';
import Scene3D from '../islands/Scene3D.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ticker = ['C#', '.NET', 'AZURE', 'ASP.NET', 'WEB API', 'BLAZOR', 'SQL SERVER', 'MONGODB', 'DOCKER', 'LOGIC APPS'];
---
<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- WebGL scene (client-only, static fallback handled inside) -->
  <Scene3D client:only="react" />

  <!-- Legibility scrim: darkens behind the copy, stronger on mobile -->
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-r from-bg via-bg/70 to-bg/20 sm:from-bg/90 sm:via-bg/30 sm:to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-40 bg-gradient-to-t from-bg to-transparent"></div>

  <!-- Corner registration marks (brutalist HUD) -->
  <div class="pointer-events-none absolute inset-0 z-[1]">
    <span class="absolute top-24 left-6 kicker text-muted">LAT 44.78 / LON 20.45</span>
    <span class="absolute top-24 right-6 kicker text-muted hidden sm:block">[ SYS: ONLINE ]</span>
    <div class="absolute top-20 left-6 h-3 w-3 border-l-2 border-t-2 border-accent"></div>
    <div class="absolute top-20 right-6 h-3 w-3 border-r-2 border-t-2 border-accent"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6 relative z-10 w-full">
    <HeroAnimation
      client:load
      name="Nikola Leleković"
      role={t('hero.role')}
      tagline={t('hero.tagline')}
      available={t('hero.available')}
    >
      <div class="hero-line flex flex-wrap gap-5 mt-12">
        <a href="#projects" class="btn-brutal" data-magnetic>{t('hero.cta.projects')} →</a>
        <a href="#contact" class="btn-brutal btn-brutal--ghost" data-magnetic>{t('hero.cta.contact')}</a>
      </div>
    </HeroAnimation>
  </div>

  <!-- Marquee ticker pinned to the bottom of the hero -->
  <div class="marquee absolute bottom-0 inset-x-0 z-10 border-y-2 border-line bg-bg/80 backdrop-blur py-3">
    <div class="marquee__track">
      {[...ticker, ...ticker].map((w) => (
        <span class="font-mono text-sm uppercase tracking-widest text-fg flex items-center gap-2.5">
          <span class="text-accent">◆</span>{w}
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  // Magnetic buttons: pull toward the cursor on desktop, snap back on leave.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (!reduce && fine) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = e.clientX - r.left - r.width / 2;
        const y = e.clientY - r.top - r.height / 2;
        el.style.transform = `translate(${x * 0.25}px, ${y * 0.3}px)`;
      });
      el.addEventListener('pointerleave', () => {
        el.style.transform = '';
      });
    });
  }
</script>
