---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { filterByLang, sortProjects } from '../../lib/projects';
import Reveal from '../islands/Reveal.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('projects');
const entries = sortProjects(filterByLang(all.map((e) => e.data), lang));
---
<section id="projects" class="mx-auto max-w-5xl px-6 py-24 scroll-mt-20">
  <Reveal client:visible>
    <h2 class="text-3xl sm:text-4xl font-bold">{t('projects.title')}</h2>
    <div class="grid sm:grid-cols-2 gap-6 mt-10">
      {entries.map((p) => (
        <article class="rounded-2xl bg-surface border border-white/10 p-6 hover:border-accent/50 transition">
          <h3 class="text-xl font-semibold">{p.title}</h3>
          <p class="text-muted text-sm mt-2">{p.description}</p>
          <ul class="flex flex-wrap gap-2 mt-4">
            {p.tags.map((tag) => (
              <li class="text-xs px-2 py-1 rounded bg-bg border border-white/10 text-muted">{tag}</li>
            ))}
          </ul>
          <div class="flex gap-4 mt-5 text-sm">
            {p.github && <a class="text-accent-2 hover:underline" href={p.github} target="_blank" rel="noopener noreferrer">{t('projects.github')}</a>}
            {p.live && <a class="text-accent-2 hover:underline" href={p.live} target="_blank" rel="noopener noreferrer">{t('projects.live')}</a>}
          </div>
        </article>
      ))}
    </div>
  </Reveal>
</section>
