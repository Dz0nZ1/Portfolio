---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Reveal from '../islands/Reveal.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: 'Email', href: 'mailto:nikola.lelekovic.rs@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/Dz0nZ1' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nikola-lelekovi%C4%87/' },
];
---
<section id="contact" class="mx-auto max-w-5xl px-6 py-24 scroll-mt-20">
  <Reveal client:visible>
    <h2 class="text-3xl sm:text-4xl font-bold">{t('contact.title')}</h2>
    <p class="text-muted mt-6">{t('contact.lead')}</p>
    <ul class="flex flex-wrap gap-4 mt-8">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener"
             class="px-5 py-3 rounded-full border border-white/15 hover:border-accent-2 hover:text-accent-2 transition">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </Reveal>
</section>
