---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Reveal from '../islands/Reveal.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: 'Email', href: 'mailto:nikola.lelekovic.rs@gmail.com', handle: 'nikola.lelekovic.rs@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/leqora', handle: '@leqora' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nikola-lelekovi%C4%87/', handle: 'in/nikola-leleković' },
];
---
<section id="contact" class="mx-auto max-w-6xl px-6 py-28 scroll-mt-20">
  <Reveal client:visible>
    <div class="flex items-center gap-4 mb-10">
      <span class="section-tag">03 / {t('nav.contact')}</span>
      <div class="h-0.5 flex-1 bg-line/30"></div>
    </div>

    <h2 class="text-5xl sm:text-7xl lg:text-8xl font-bold uppercase leading-[0.9] glitch" data-text={t('contact.title')}>
      {t('contact.title')}
    </h2>
    <p class="text-muted mt-8 max-w-xl font-mono text-sm sm:text-base leading-relaxed">{t('contact.lead')}</p>

    <ul class="mt-12 border-t-2 border-line">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer"
             class="group flex items-center justify-between gap-4 border-b-2 border-line py-5 sm:py-6 px-2 hover:bg-accent hover:text-black transition-colors">
            <span class="font-display text-2xl sm:text-4xl font-bold uppercase">{l.label}</span>
            <span class="font-mono text-xs sm:text-sm text-muted group-hover:text-black hidden sm:block">{l.handle}</span>
            <span class="font-mono text-xl group-hover:translate-x-1 transition-transform">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </Reveal>
</section>
